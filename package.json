{
  "name": "ecoscan",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "mobile"
  ],
  "scripts": {
    "dev": "concurrently -n backend,mobile -c blue,green \"npm run dev --workspace backend\" \"npm run start --workspace mobile\"",
    "typecheck": "npm run typecheck --workspace mobile",
    "seed:ecopoints": "npm run seed:ecopoints --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
