# ============================================================
# EcoScan — variáveis de ambiente (copie para .env.local)
# ============================================================

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3000/api

# --- Backend (Node.js) ---
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ecoscan

# Auth
JWT_SECRET=troque-por-uma-string-segura
JWT_EXPIRES_IN=7d

# IA (imagem → categoria de resíduo)
OPENAI_API_KEY=sk-...
# ou GEMINI_API_KEY=...

# Storage (imagens dos scans)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mapas
GOOGLE_MAPS_API_KEY=
