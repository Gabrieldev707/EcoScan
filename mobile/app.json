{
  "expo": {
    "name": "EcoScan",
    "slug": "ecoscan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07090a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ecoscan.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07090a"
      },
      "package": "com.ecoscan.app"
    },
    "plugins": [
      "expo-font",
      ["expo-camera", { "cameraPermission": "Precisamos da câmera para identificar resíduos." }],
      ["expo-location", { "locationWhenInUsePermission": "Usamos sua localização para registrar onde o descarte foi feito." }]
    ]
  }
}
