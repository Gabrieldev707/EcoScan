{
  "name": "ecoscan-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --lan",
    "start:lan": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --lan --clear",
    "start:tunnel": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --tunnel --clear",
    "start:localhost": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --localhost --clear",
    "android": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --android --lan",
    "ios": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --ios --lan",
    "web": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/barlow": "^0.2.3",
    "@expo-google-fonts/bebas-neue": "^0.2.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/stack": "^7.1.1",
    "axios": "^1.16.1",
    "expo": "^54.0.0",
    "expo-camera": "~17.0.10",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "cross-env": "^10.1.0",
    "typescript": "^5.8.3"
  }
}
